{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@modules/utils": ["./src/index.ts"],
      "@modules/utils/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
